# Used by `npm run dev:emulators` — talks to the local Firebase Emulator Suite only.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-foodcoins.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-foodcoins
VITE_FIREBASE_STORAGE_BUCKET=demo-foodcoins.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_USE_EMULATORS=true
