rules_version = '2';

// FoodCoins security rules.
// The client may only READ its own data. Every write that matters (progress, coins,
// reward transactions, level sessions) is performed by Cloud Functions via the Admin SDK,
// which bypasses these rules after verifying the level result on the server.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /progress/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /wallet/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Level sessions hold the server-issued seed; managed by Cloud Functions only.
      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    // Deny everything else by default (restaurants/discounts will get their own rules later).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
