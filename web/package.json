  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "firebase": "^11.10.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^13.35.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "private": true
