{
  "name": "foodcoins",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emulators": "node scripts/sync-engine.js && firebase emulators:exec --only auth,firestore,functions --project demo-foodcoins \"vitest run --config vitest.emulator.config.js\"",
    "emulators": "node scripts/sync-engine.js && firebase emulators:start --only auth,firestore,functions --project demo-foodcoins",
    "simulate": "node scripts/simulate.js",
    "art": "python3 scripts/generate_art.py",
    "deploy": "firebase deploy"
  },
  "keywords": [],
